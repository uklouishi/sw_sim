; Engine configuration file.
; Godot 4.7 .NET 版。用 Godot 编辑器（.NET 版）打开本文件夹即可运行。

config_version=5

[application]

config/name="WS Sim"
config/description="Weiss Schwarz 对战模拟器（ws_sim）"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="WsSim.Client"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
